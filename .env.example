NODE_ENV=development
PORT=5000

# Transactions need a replica set (see docker-compose.yml). Set USE_TRANSACTIONS=false for a standalone mongod.
MONGO_URI=

JWT_ACCESS_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
ACCESS_TOKEN_EXPIRES_MIN=15
REFRESH_TOKEN_EXPIRES_DAYS=7
BCRYPT_ROUNDS=12

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
COOKIE_SAMESITE=lax
ALLOW_PUBLIC_REGISTRATION=true
ENABLE_DOCS=true
TRUST_PROXY=false

SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=Admin@123

