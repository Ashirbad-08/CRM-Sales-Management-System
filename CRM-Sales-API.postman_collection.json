{
  "info": {
    "_postman_id": "fbcfeb2d-6de0-4e43-90dd-a51e70db41dc",
    "name": "CRM Sales Management API",
    "description": "Import this collection into Postman. Run Authentication > Login first; its test script saves `accessToken` for the protected requests. Seeded local admin: admin@crm.local / Admin@12345.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "accessToken", "value": "" },
    { "key": "userId", "value": "REPLACE_WITH_USER_ID" },
    { "key": "leadId", "value": "REPLACE_WITH_LEAD_ID" },
    { "key": "customerId", "value": "REPLACE_WITH_CUSTOMER_ID" },
    { "key": "dealId", "value": "REPLACE_WITH_DEAL_ID" },
    { "key": "activityId", "value": "REPLACE_WITH_ACTIVITY_ID" },
    { "key": "configKey", "value": "sales.target" }
  ],
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level tests: Postman runs these after EVERY request in this collection.",
          "pm.test('Response status is successful (2xx)', function () {",
          "  pm.expect(pm.response.code).to.be.within(200, 299);",
          "});",
          "pm.test('Response is JSON', function () {",
          "  pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json');",
          "});",
          "let body;",
          "pm.test('Response uses the CRM success envelope', function () {",
          "  body = pm.response.json();",
          "  pm.expect(body).to.have.property('success', true);",
          "  pm.expect(body).to.have.property('message').that.is.a('string');",
          "  pm.expect(body).to.have.property('data');",
          "});",
          "const createdRequests = ['Register executive', 'Create user', 'Create lead', 'Convert qualified lead', 'Create customer', 'Create deal', 'Create activity'];",
          "if (createdRequests.includes(pm.info.requestName)) {",
          "  pm.test('Create endpoint returns HTTP 201', function () {",
          "    pm.expect(pm.response.code).to.equal(201);",
          "  });",
          "  pm.test('Created resource contains an ObjectId', function () {",
          "    const resource = body.data.lead || body.data.user || body.data;",
          "    pm.expect(resource).to.have.property('_id').that.matches(/^[a-f\\d]{24}$/i);",
          "  });",
          "}",
          "const paginatedRequests = /^(List |.* timeline$|.* activities$|Entity timeline$)/;",
          "if (paginatedRequests.test(pm.info.requestName)) {",
          "  pm.test('Paginated endpoint returns an array', function () {",
          "    pm.expect(body.data).to.be.an('array');",
          "  });",
          "  pm.test('Pagination metadata is valid', function () {",
          "    pm.expect(body.pagination).to.include.keys('currentPage', 'pageSize', 'totalRecords', 'totalPages', 'hasNextPage', 'hasPrevPage');",
          "    pm.expect(body.pagination.currentPage).to.be.at.least(1);",
          "  });",
          "}",
          "if (['Login (saves token)', 'Refresh token', 'Change password'].includes(pm.info.requestName)) {",
          "  pm.test('Authentication response includes a user and access token', function () {",
          "    pm.expect(body.data.user).to.have.property('_id');",
          "    pm.expect(body.data.accessToken).to.be.a('string').and.not.empty;",
          "  });",
          "}",
          "if (pm.info.requestName === 'Get my profile') {",
          "  pm.test('Profile response contains the authenticated user', function () {",
          "    pm.expect(body.data.user).to.include.keys('_id', 'name', 'email', 'role');",
          "  });",
          "}",
          "if (pm.info.requestName === 'Complete activity') {",
          "  pm.test('Completed activity has Completed status', function () {",
          "    pm.expect(body.data.status).to.equal('Completed');",
          "  });",
          "}",
          "// Login, refresh and password change return a new access token. Keep it automatically.",
          "if (body && body.data && body.data.accessToken) {",
          "  pm.collectionVariables.set('accessToken', body.data.accessToken);",
          "}",
          "const idVariables = { 'Create user': 'userId', 'Create lead': 'leadId', 'Create customer': 'customerId', 'Create deal': 'dealId', 'Create activity': 'activityId' };",
          "if (idVariables[pm.info.requestName] && body.data && body.data._id) {",
          "  pm.collectionVariables.set(idVariables[pm.info.requestName], body.data._id);",
          "}",
          "if (pm.info.requestName === 'Convert qualified lead' && body.data) {",
          "  if (body.data.lead && body.data.lead._id) pm.collectionVariables.set('leadId', body.data.lead._id);",
          "  if (body.data.customer && body.data.customer._id) pm.collectionVariables.set('customerId', body.data.customer._id);",
          "  if (body.data.deal && body.data.deal._id) pm.collectionVariables.set('dealId', body.data.deal._id);",
          "}",
          "pm.test('Response time is under 2 seconds', function () {",
          "  pm.expect(pm.response.responseTime).to.be.below(2000);",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [{ "name": "Health check", "request": { "method": "GET", "url": "http://localhost:5000/health" } }]
    },
    {
      "name": "Authentication",
      "item": [
        { "name": "Register executive", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane@example.com\",\n  \"phone\": \"+919876543210\",\n  \"password\": \"Strong@123\"\n}" }, "url": "{{baseUrl}}/auth/register" } },
        { "name": "Login (saves token)", "event": [{ "listen": "test", "script": { "exec": ["const json = pm.response.json();", "if (json.data && json.data.accessToken) pm.collectionVariables.set('accessToken', json.data.accessToken);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@crm.local\",\n  \"password\": \"Admin@12345\"\n}" }, "url": "{{baseUrl}}/auth/login" } },
        { "name": "Refresh token", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{}" }, "url": "{{baseUrl}}/auth/refresh" } },
        { "name": "Logout", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{}" }, "url": "{{baseUrl}}/auth/logout" } },
